---
const today = new Date();
---

<footer class="mt-auto border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center text-gray-600 dark:text-gray-400 text-sm">
      <p>&copy; {today.getFullYear()} {import.meta.env.SITE || 'My Blog'}. All rights reserved.</p>
      <p class="mt-2">Built with <a href="https://astro.build" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline">Astro</a></p>
    </div>
  </div>
</footer>