---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<div class="audio-player mt-4 mb-2">
  <audio controls preload="metadata" src={src} class="w-full h-10"></audio>
</div>

<style>
  .audio-player {
    max-width: 400px;
  }

  .audio-player audio {
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .audio-player audio:hover,
  .audio-player audio:focus {
    opacity: 1;
  }
</style>
