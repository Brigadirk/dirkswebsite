---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 bg-bauhaus-black/95 backdrop-blur-md border-b border-sky-400/50">
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo with cross accent -->
      <div class="flex items-center gap-4">
        <button
          id="close-content"
          class="text-bauhaus-red hover:text-bauhaus-red/70 transition-colors duration-300 text-lg font-bold leading-none"
          aria-label="Close content"
        >✕</button>
        <a
          href="/"
          class="text-2xl font-bold tracking-tight text-bauhaus-cream hover:text-bauhaus-yellow transition-colors duration-300"
        >
          {SITE_TITLE}
        </a>
      </div>

      <!-- Navigation -->
      <div class="flex items-center gap-8">
        <div class="hidden md:flex items-center gap-6">
          <a
            href="/about"
            class="relative text-bauhaus-cream/80 hover:text-bauhaus-yellow font-medium tracking-wide transition-colors duration-300 group"
          >
            About
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-bauhaus-yellow transition-all duration-300 group-hover:w-full"></span>
          </a>
        </div>

        <!-- Separator -->
        <div class="hidden md:block w-px h-6 bg-bauhaus-steel"></div>

        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<!-- Light mode styles -->
<style>
  :global(.light) header {
    @apply bg-bauhaus-cream/95;
    border-color: rgb(56 189 248 / 0.5) !important;
  }

  :global(.light) header a {
    @apply text-bauhaus-black;
  }

  :global(.light) header a:hover {
    @apply text-bauhaus-red;
  }

  :global(.light) header nav > div > div:last-child > div:first-child a span {
    @apply bg-bauhaus-red;
  }

  /* Gay mode styles */
  :global(.gay) header {
    background: linear-gradient(90deg, rgba(255,105,180,0.95), rgba(255,215,0,0.95), rgba(155,89,182,0.95));
    border-color: #FFD700;
  }

  :global(.gay) header a {
    @apply text-white;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  }

  :global(.gay) header a:hover {
    @apply text-yellow-200;
  }

  :global(.gay) #close-content {
    background: linear-gradient(45deg, #FF69B4, #FFD700, #FF69B4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: sparkle 1s ease-in-out infinite;
  }

  @keyframes sparkle {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.2) rotate(180deg); }
  }
</style>

<script>
  function setupCloseButton() {
    const closeButton = document.getElementById('close-content');

    if (closeButton) {
      closeButton.addEventListener('click', () => {
        document.body.classList.add('content-hidden');
        closeButton.style.display = 'none';
      });
    }
  }

  setupCloseButton();
  document.addEventListener('astro:after-swap', setupCloseButton);
</script>
