---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <figure class="homepage-art">
    <img
      src="/chimpanzee-anatomy-lesson-dirks-website-wordart-90s.png"
      alt="A candlelit anatomy lesson conducted by chimpanzees, with Dirk's Website in colourful 1990s word art."
      width="1672"
      height="941"
      fetchpriority="high"
      decoding="async"
    />
  </figure>

  <!-- Blog posts grid -->
  <div class="space-y-0">
    {posts.map((post, index) => (
      <article class="group relative py-8 border-b border-bauhaus-red/30 transition-all duration-300">
        <a href={`/blog/${post.id}/`} class="block">
          <div class="space-y-4">
            <!-- Date -->
            <p class="text-sm text-bauhaus-cream/50 uppercase tracking-widest font-medium">
              <span class="text-green-800">&gt;</span> <FormattedDate date={post.data.pubDate} />
            </p>

            <!-- Title -->
            <h2 class="text-3xl md:text-4xl font-bold text-bauhaus-cream group-hover:text-bauhaus-red transition-colors duration-300 tracking-tight">
              {post.data.title}
            </h2>

            <!-- Description -->
            <p class="text-lg text-bauhaus-cream/70 leading-relaxed max-w-2xl">
              {post.data.description}
            </p>
          </div>
        </a>
      </article>
    ))}
  </div>

  <!-- Empty state -->
  {posts.length === 0 && (
    <div class="text-center py-16">
      <div class="w-4 h-4 bg-bauhaus-red animate-pulse mx-auto mb-6"></div>
      <p class="text-bauhaus-cream/60 text-lg">No posts yet. Check back soon.</p>
    </div>
  )}
</Layout>

<!-- Light mode overrides -->
<style>
  .homepage-art {
    margin: 0 0 2rem;
    overflow: hidden;
    border: 1px solid rgb(56 189 248 / 0.42);
    background: #070d16;
  }

  .homepage-art img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(.light) h1 {
    color: #1a1a1a;
  }

  :global(.light) h1 span {
    color: #E53935;
  }

  :global(.light) h2 {
    color: #1a1a1a;
  }

  :global(.light) article p {
    color: #333;
  }

  :global(.light) article > a > div > div:first-child p {
    color: #666;
  }

  :global(.light) .text-bauhaus-cream {
    color: #1a1a1a !important;
  }

  :global(.light) .text-bauhaus-cream\/50,
  :global(.light) .text-bauhaus-cream\/70 {
    color: #444 !important;
  }

  /* Gay mode - FABULOUS */
  :global(.gay) h1 {
    @apply text-white;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.3), 0 0 20px #FFD700;
  }

  :global(.gay) h1 span {
    background: linear-gradient(90deg, #FF69B4, #FFD700, #FF69B4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(.gay) .h-1.w-48 {
    background: linear-gradient(90deg, red, orange, yellow, green, blue, purple);
  }

  :global(.gay) .w-6.h-6 {
    background: linear-gradient(45deg, #FF69B4, #FFD700) !important;
    border-radius: 50%;
    animation: gay-pulse 1s ease-in-out infinite;
  }


  :global(.gay) h2 {
    @apply text-white;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  }

  :global(.gay) article h2:hover {
    background: linear-gradient(90deg, #FF69B4, #FFD700);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(.gay) article p {
    @apply text-white/90;
  }

  :global(.gay) article .text-bauhaus-red {
    color: #FFD700 !important;
  }

  :global(.gay) article .w-2.h-2 {
    background: #FFD700 !important;
    border-radius: 50%;
    box-shadow: 0 0 10px #FFD700;
  }

  @keyframes gay-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 10px #FF69B4; }
    50% { transform: scale(1.1); box-shadow: 0 0 20px #FFD700; }
  }

</style>
