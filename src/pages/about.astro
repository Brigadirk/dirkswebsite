---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`About | ${SITE_TITLE}`} description="About Dirk">
  <div class="prose prose-lg prose-bauhaus max-w-none">
    <p class="text-xl text-bauhaus-cream/90 leading-relaxed">
      My name is Dirk and I started blogging as my new year's resolution for 2026.
      I am co-organizing <a href="https://conconeurope.com" class="text-bauhaus-yellow border-b border-bauhaus-yellow/30 hover:border-bauhaus-yellow transition-colors no-underline">ConCon Europe</a> and
      working on a movement startup called <a href="https://based.guide" class="text-bauhaus-yellow border-b border-bauhaus-yellow/30 hover:border-bauhaus-yellow transition-colors no-underline">Based Guide</a>.
    </p>
  </div>
</Layout>

<style>
  :global(.light) h1 {
    color: #1a1a1a !important;
  }

  :global(.light) p {
    color: #333 !important;
  }

  :global(.gay) h1 {
    color: white !important;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.3), 0 0 20px #FFD700;
  }

  :global(.gay) p {
    color: white !important;
  }
</style>
