---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
---

<Layout
  title="About Me"
  description="Learn more about me and this blog"
  image={AboutHeroImage}
>
  <div class="max-w-3xl">
    <div class="mb-8">
      <Image 
        src={AboutHeroImage} 
        alt="About" 
        width={1020}
        height={510}
        class="w-full rounded-lg shadow-lg mb-8"
      />
    </div>
    
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
      About Me
    </h1>
    
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <p>
        Welcome! I'm a passionate developer and writer who loves to share knowledge 
        and experiences through this blog. Here, you'll find articles about web development, 
        technology trends, and my journey in the tech world.
      </p>
      
      <h2>What I Do</h2>
      <p>
        I specialize in modern web development, with a focus on building fast, accessible, 
        and user-friendly applications. My toolkit includes technologies like TypeScript, 
        React, Astro, and various other frameworks and tools that help create amazing 
        web experiences.
      </p>
      
      <h2>Why This Blog?</h2>
      <p>
        This blog serves as a platform to document my learning journey, share insights 
        with the community, and help others who might be facing similar challenges. 
        I believe in learning in public and contributing back to the developer community 
        that has helped me grow.
      </p>
      
      <h2>Get in Touch</h2>
      <p>
        Feel free to connect with me on social media or leave comments on my blog posts. 
        I'm always happy to discuss technology, collaborate on projects, or simply chat 
        about the latest developments in the web world.
      </p>
    </div>
  </div>
</Layout>