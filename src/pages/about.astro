---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`About | ${SITE_TITLE}`} description="About Dirk">
  <article class="prose prose-lg prose-bauhaus max-w-none">
    <header class="mb-12 relative">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-bauhaus-cream leading-tight tracking-tight">
        About
      </h1>
      <div class="h-px w-full bg-bauhaus-red/30"></div>
    </header>

    <div class="prose prose-lg prose-bauhaus max-w-none">
      <p class="text-xl text-bauhaus-cream/90 leading-relaxed">
        My name is Dirk and I started blogging as my new year's resolution for 2026.
      </p>
    </div>
  </article>
</Layout>

<style>
  :global(.light) h1 {
    color: #1a1a1a !important;
  }

  :global(.light) p {
    color: #333 !important;
  }

  :global(.gay) h1 {
    color: white !important;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.3), 0 0 20px #FFD700;
  }

  :global(.gay) p {
    color: white !important;
  }
</style>
