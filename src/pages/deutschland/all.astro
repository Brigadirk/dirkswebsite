---
import { getCollection, render } from 'astro:content';
import TranscriptPost from '../../layouts/TranscriptPost.astro';
import {
	formatDate,
	markdownFilenameForPost,
	sortDeutschlandPosts,
	titleParts,
	titleWithoutDate,
} from '../../lib/deutschland';

const posts = sortDeutschlandPosts(await getCollection('deutschland'));
const renderedPosts = await Promise.all(
	posts.map(async (post) => ({
		post,
		Content: (await render(post)).Content,
	})),
);
---

<TranscriptPost
	title="All"
	description="All David Deutsch podcast and lecture transcripts in sequence."
	pubDate={posts[0]?.data.pubDate ?? new Date()}
>
	<a class="markdown-download" href="/deutschland/all.md" download="deutschland-complete-sequence.md">
		Markdown
	</a>
	<a class="sequence-index-link" href="#index">Index</a>
	{renderedPosts.map(({ post, Content }) => (
		<section class="transcript-entry" id={`part-${post.id}`}>
			<header class="transcript-entry-header">
				<h2 class="transcript-title text-4xl md:text-5xl font-bold mb-4 text-bauhaus-cream leading-tight tracking-tight">
					<a class="transcript-title-link" href={`/deutschland/${post.id}/`}>
						{(() => {
							const parts = titleParts(post.data.title, post.data.pubDate);

							return (
								<>
									<span class="transcript-title-date">{parts.date}</span>
									{parts.source && <span class="transcript-title-source">{parts.source}</span>}
									<span class="transcript-title-name">{parts.title}</span>
								</>
							);
						})()}
					</a>
				</h2>
				<div class="h-px w-full bg-sky-400/50"></div>
			</header>
			<div class="transcript-content transcript-entry-content prose prose-lg prose-bauhaus max-w-none">
				<Content />
				<a class="markdown-download" href={`/deutschland/${post.id}.md`} download={markdownFilenameForPost(post)}>
					Markdown
				</a>
			</div>
		</section>
	))}
	<section class="sequence-index" id="index">
		<h2>Index</h2>
		<ol>
			{posts.map((post) => (
				<li>
					<a href={`#part-${post.id}`}>
						<time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
						<span>-</span>
						<span>{titleWithoutDate(post.data.title)}</span>
					</a>
				</li>
			))}
		</ol>
	</section>
</TranscriptPost>
