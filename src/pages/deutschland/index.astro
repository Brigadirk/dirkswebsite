---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { formatDate, sortDeutschlandPosts, titleWithoutDate } from '../../lib/deutschland';

const posts = sortDeutschlandPosts(await getCollection('deutschland'));
---

<Layout title={`Deutschland | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="mb-10">
    <h1 class="text-5xl md:text-7xl font-bold text-bauhaus-cream tracking-tighter mb-4">
      Deutschland
    </h1>
    <div class="h-1 w-48 bg-sky-400"></div>
  </section>

  <p class="deutschland-intro">
    I like the work of David Deutsch. Aside from his excellent books "The Beginning of Infinity" and
    "The Fabric of Reality", a lot of his ideas are scattered among podcasts, interviews, articles,
    and radio appearances.
    Since I often cannot remember where and when something was said that might be of interest to me,
    I've taken it upon myself and my AI to get all of it together. All the credit goes to David Deutsch
    as well as the interviewers, writers, publishers, podcasters, and showmakers, to whom I've linked
    wherever possible. There are still some mistakes found here and there, and I've only thus far had
    the time to scan through most of the transcripts to correct them. If there are any mistakes I
    haven't caught yet do let me know.
  </p>

  <p class="deutschland-intro deutschland-coverage">
    Every entry is searchable in English. When I cannot publish the complete work locally, its page
    indexes the questions, claims, names, and technical terms and links to the complete source.
  </p>

  <section class="deutschland-search" data-deutschland-search>
    <form role="search">
      <label for="deutschland-query">Search the archive</label>
      <div class="deutschland-search-field">
        <input
          id="deutschland-query"
          type="search"
          name="q"
          placeholder="Try 'epistemology' or 'quantum computation'"
          autocomplete="off"
          enterkeyhint="search"
          aria-controls="deutschland-posts"
          aria-describedby="deutschland-search-help deutschland-search-status"
        />
        <button type="button" class="deutschland-search-clear" aria-label="Clear search" hidden>
          Clear
        </button>
      </div>
      <div class="deutschland-search-meta">
        <p id="deutschland-search-help">
          Search titles, descriptions, article notes, and transcript text. Small typos are fine.
        </p>
        <p id="deutschland-search-status" role="status" aria-live="polite">
          {posts.length} entries
        </p>
      </div>
    </form>
    <p class="deutschland-no-results" hidden>
      Nothing matched. Try fewer words or a different spelling.
    </p>
    <p class="deutschland-publisher-search" data-deutschland-publisher-search hidden>
      Need the exact wording?
      <a href="https://www.google.com/search" target="_blank" rel="noreferrer">
        Search the publishers' originals with Google.
      </a>
    </p>
  </section>

  <ol class="deutschland-list" id="deutschland-posts">
    <li class="featured">
      <a href="/deutschland/all/">
        <span>All</span>
      </a>
      <a class="download-link" href="/deutschland/all.md" download="deutschland-complete-sequence.md">Markdown</a>
    </li>
    {posts.map((post) => (
      <li data-search-post={post.id}>
        <a href={`/deutschland/${post.id}/`}>
          <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
          <span>-</span>
          <span>{titleWithoutDate(post.data.title)}</span>
        </a>
        <span class="deutschland-search-match" hidden></span>
      </li>
    ))}
  </ol>
</Layout>

<script>
  import {
    searchDeutschlandIndex,
    type DeutschlandSearchIndex,
  } from '../../lib/deutschland-search';
  import { deutschlandPublisherSearchUrl } from '../../lib/deutschland-publisher-search';

  const searchRoot = document.querySelector<HTMLElement>('[data-deutschland-search]');
  const form = searchRoot?.querySelector<HTMLFormElement>('form');
  const input = searchRoot?.querySelector<HTMLInputElement>('#deutschland-query');
  const clearButton = searchRoot?.querySelector<HTMLButtonElement>('.deutschland-search-clear');
  const status = searchRoot?.querySelector<HTMLElement>('#deutschland-search-status');
  const noResults = searchRoot?.querySelector<HTMLElement>('.deutschland-no-results');
  const publisherSearch = searchRoot?.querySelector<HTMLElement>('[data-deutschland-publisher-search]');
  const publisherSearchLink = publisherSearch?.querySelector<HTMLAnchorElement>('a');
  const list = document.querySelector<HTMLOListElement>('#deutschland-posts');

  if (
    searchRoot &&
    form &&
    input &&
    clearButton &&
    status &&
    noResults &&
    publisherSearch &&
    publisherSearchLink &&
    list
  ) {
    const originalItems = Array.from(list.children) as HTMLElement[];
    const postItems = new Map(
      originalItems
        .filter((item) => item.dataset.searchPost)
        .map((item) => [item.dataset.searchPost as string, item]),
    );
    const entryCount = postItems.size;
    let searchIndexPromise: Promise<DeutschlandSearchIndex> | undefined;
    let debounceTimer: number | undefined;
    let searchSequence = 0;

    const setSearching = (isSearching: boolean) => {
      form.toggleAttribute('aria-busy', isSearching);
      list.toggleAttribute('aria-busy', isSearching);
    };

    const loadSearchIndex = () => {
      searchIndexPromise ??= fetch('/deutschland/search-index.json', {
        headers: { Accept: 'application/json' },
      })
        .then(async (response) => {
          if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);

          const index = (await response.json()) as DeutschlandSearchIndex;
          if (index.version !== 1) throw new Error('Unsupported Deutschland search index');
          return index;
        })
        .catch((error) => {
          searchIndexPromise = undefined;
          throw error;
        });

      return searchIndexPromise;
    };

    const updateQueryInUrl = (query: string) => {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const updatePublisherSearch = (query: string) => {
      const canSearch = query.length >= 2;
      publisherSearch.hidden = !canSearch;
      if (canSearch) publisherSearchLink.href = deutschlandPublisherSearchUrl(query);
    };

    const restoreArchive = () => {
      list.replaceChildren(...originalItems);
      noResults.hidden = true;

      for (const item of postItems.values()) {
        const match = item.querySelector<HTMLElement>('.deutschland-search-match');
        if (match) match.hidden = true;
      }
    };

    const renderResults = (
      index: DeutschlandSearchIndex,
      query: string,
      results: ReturnType<typeof searchDeutschlandIndex>,
    ) => {
      const matchedItems: HTMLElement[] = [];

      for (const result of results) {
        const post = index.posts[result.postIndex];
        const item = postItems.get(post.id);
        if (!item) continue;

        const match = item.querySelector<HTMLElement>('.deutschland-search-match');
        if (match) {
          match.textContent = `Matched: ${result.matchedTerms.join(', ')}`;
          match.hidden = false;
        }

        matchedItems.push(item);
      }

      list.replaceChildren(...matchedItems);
      noResults.hidden = matchedItems.length > 0;
      status.textContent = `${matchedItems.length} ${matchedItems.length === 1 ? 'entry' : 'entries'} matched "${query}".`;
    };

    const runSearch = async (rawQuery: string) => {
      const query = rawQuery.trim();
      const sequence = ++searchSequence;
      clearButton.hidden = query.length === 0;
      updateQueryInUrl(query);
      updatePublisherSearch(query);

      if (query.length === 0) {
        setSearching(false);
        restoreArchive();
        status.textContent = `${entryCount} entries`;
        return;
      }

      if (query.length < 2) {
        setSearching(false);
        restoreArchive();
        status.textContent = 'Type at least 2 characters.';
        return;
      }

      setSearching(true);
      status.textContent = 'Searching…';

      try {
        const index = await loadSearchIndex();
        if (sequence !== searchSequence) return;
        renderResults(index, query, searchDeutschlandIndex(index, query));
      } catch (error) {
        if (sequence !== searchSequence) return;
        console.error(error);
        restoreArchive();
        status.textContent = 'Search could not load. The full archive is still available.';
      } finally {
        if (sequence === searchSequence) setSearching(false);
      }
    };

    const queueSearch = () => {
      searchSequence += 1;
      const query = input.value.trim();
      clearButton.hidden = query.length === 0;
      updatePublisherSearch(query);
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => void runSearch(input.value), 120);
    };

    input.addEventListener('focus', () => void loadSearchIndex().catch(() => undefined));
    input.addEventListener('input', queueSearch);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value) {
        event.preventDefault();
        input.value = '';
        void runSearch('');
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(debounceTimer);
      void runSearch(input.value);
    });
    clearButton.addEventListener('click', () => {
      input.value = '';
      input.focus();
      void runSearch('');
    });

    const initialQuery = new URL(window.location.href).searchParams.get('q')?.trim();
    if (initialQuery) {
      input.value = initialQuery;
      void runSearch(initialQuery);
    }
  }
</script>

<style>
  .deutschland-intro {
    max-width: 46rem;
    margin: -1.35rem 0 1.75rem;
    color: rgb(245 241 226 / 0.78);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .deutschland-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .deutschland-coverage {
    margin-top: -1rem;
  }

  .deutschland-search {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .deutschland-search label {
    display: block;
    margin-bottom: 0.55rem;
    color: rgb(245 241 226);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.025em;
  }

  .deutschland-search-field {
    position: relative;
  }

  .deutschland-search input {
    width: 100%;
    border: 1px solid rgb(56 189 248 / 0.42);
    border-bottom-width: 3px;
    border-radius: 0;
    padding: 0.8rem 4.25rem 0.75rem 0.9rem;
    background: rgb(245 241 226 / 0.055);
    color: rgb(245 241 226);
    font: inherit;
    line-height: 1.35;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .deutschland-search input::placeholder {
    color: rgb(245 241 226 / 0.42);
  }

  .deutschland-search input:focus {
    border-color: #38bdf8;
    outline: 2px solid rgb(56 189 248 / 0.28);
    outline-offset: 2px;
    background: rgb(245 241 226 / 0.075);
  }

  .deutschland-search input::-webkit-search-cancel-button {
    display: none;
  }

  .deutschland-search-clear {
    position: absolute;
    top: 50%;
    right: 0.85rem;
    transform: translateY(-50%);
    border: 0;
    padding: 0.2rem;
    background: transparent;
    color: #ef4444;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .deutschland-search-clear:hover {
    color: #f87171;
  }

  .deutschland-search-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 0.55rem;
    color: rgb(245 241 226 / 0.55);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .deutschland-search-meta p {
    margin: 0;
  }

  #deutschland-search-status {
    flex: none;
    text-align: right;
  }

  .deutschland-no-results {
    margin: 1.5rem 0 0;
    border-left: 3px solid #ef4444;
    padding: 0.15rem 0 0.15rem 0.85rem;
    color: rgb(245 241 226 / 0.78);
  }

  .deutschland-publisher-search {
    margin: 0.65rem 0 0;
    color: rgb(245 241 226 / 0.65);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .deutschland-publisher-search a {
    color: #38bdf8;
  }

  .deutschland-publisher-search a:hover {
    color: #7dd3fc;
  }

  .deutschland-search-match {
    color: #ef4444;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .deutschland-list li + li {
    margin-top: 0.35rem;
  }

  .deutschland-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    align-items: baseline;
  }

  .deutschland-list .featured {
    margin-bottom: 1.1rem;
  }

  .deutschland-list a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: baseline;
    color: rgb(245 241 226 / 0.86);
    line-height: 1.35;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .deutschland-list .download-link {
    color: #ef4444;
    font-size: 0.82rem;
  }

  .deutschland-list a:hover {
    color: #38bdf8;
  }

  .deutschland-list .download-link:hover {
    color: #f87171;
  }

  .deutschland-list time {
    color: rgb(245 241 226 / 0.55);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  :global(.light) .deutschland-list a {
    color: #1a1a1a;
  }

  :global(.light) .deutschland-intro {
    color: #3f3f3f;
  }

  :global(.light) .deutschland-list a:hover {
    color: #0369a1;
  }

  :global(.light) .deutschland-list .download-link {
    color: #b91c1c;
  }

  :global(.light) .deutschland-list .download-link:hover {
    color: #991b1b;
  }

  :global(.light) .deutschland-list time {
    color: #666;
  }

  :global(.light) .deutschland-search label,
  :global(.light) .deutschland-search input {
    color: #1a1a1a;
  }

  :global(.light) .deutschland-search input {
    background: rgb(2 132 199 / 0.035);
  }

  :global(.light) .deutschland-search input::placeholder,
  :global(.light) .deutschland-search-meta {
    color: #666;
  }

  :global(.light) .deutschland-no-results {
    color: #3f3f3f;
  }

  :global(.light) .deutschland-publisher-search {
    color: #555;
  }

  :global(.light) .deutschland-publisher-search a {
    color: #0369a1;
  }

  :global(.light) .deutschland-publisher-search a:hover {
    color: #075985;
  }

  :global(.light) .deutschland-search-clear,
  :global(.light) .deutschland-search-match {
    color: #b91c1c;
  }

  :global(.light) .deutschland-search-clear:hover {
    color: #991b1b;
  }

  @media (max-width: 40rem) {
    .deutschland-search-meta {
      display: block;
    }

    #deutschland-search-status {
      margin-top: 0.25rem;
      text-align: left;
    }
  }
</style>
