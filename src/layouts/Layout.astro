---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description: string;
  image?: any;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <script is:inline>
      // Bauhaus is dark by default - only change if explicitly set
      const theme = (() => {
        if (typeof localStorage !== 'undefined') {
          const stored = localStorage.getItem('theme');
          if (['light', 'gay'].includes(stored)) return stored;
        }
        return 'dark';
      })();

      document.documentElement.classList.remove('dark', 'light', 'gay');
      document.documentElement.classList.add(theme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-bauhaus relative overflow-x-hidden">
    <!-- Floating geometric decorations (bauhaus modes) -->
    <div class="bauhaus-decorations fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
      <!-- Large square - top right -->
      <div class="absolute -top-24 -right-24 w-64 h-64 border border-bauhaus-red/[0.04] rotate-12"></div>

      <!-- Medium square - bottom left -->
      <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-bauhaus-red/[0.02]"></div>
    </div>

    <!-- Gay mode floating sparkles -->
    <div class="gay-decorations fixed inset-0 pointer-events-none overflow-hidden z-0 hidden" aria-hidden="true">
      <div class="sparkle sparkle-1">✨</div>
      <div class="sparkle sparkle-2">💖</div>
      <div class="sparkle sparkle-3">🌈</div>
      <div class="sparkle sparkle-4">⭐</div>
      <div class="sparkle sparkle-5">💫</div>
      <div class="sparkle sparkle-6">🦄</div>
      <div class="sparkle sparkle-7">💜</div>
      <div class="sparkle sparkle-8">✨</div>
      <div class="sparkle sparkle-9">💖</div>
      <div class="sparkle sparkle-10">🌟</div>
    </div>

    <!-- Top accent bar -->
    <div class="top-accent-bar h-px w-full bg-bauhaus-red"></div>

    <Header />

    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
      <slot />
    </main>

    <style>
      /* Gay mode specific styles */
      :global(.gay) .bauhaus-decorations {
        display: none;
      }

      :global(.gay) .gay-decorations {
        display: block;
      }

      :global(.gay) .top-accent-bar {
        background: linear-gradient(90deg, red, orange, yellow, green, blue, purple);
        height: 4px;
      }

      .sparkle {
        position: absolute;
        font-size: 2rem;
        animation: float-sparkle 6s ease-in-out infinite;
      }

      .sparkle-1 { top: 10%; left: 5%; animation-delay: 0s; }
      .sparkle-2 { top: 20%; right: 10%; animation-delay: 0.5s; }
      .sparkle-3 { top: 40%; left: 8%; animation-delay: 1s; }
      .sparkle-4 { top: 60%; right: 5%; animation-delay: 1.5s; }
      .sparkle-5 { top: 80%; left: 3%; animation-delay: 2s; }
      .sparkle-6 { top: 15%; left: 90%; animation-delay: 2.5s; }
      .sparkle-7 { top: 50%; right: 3%; animation-delay: 3s; }
      .sparkle-8 { top: 70%; left: 10%; animation-delay: 3.5s; }
      .sparkle-9 { top: 30%; right: 8%; animation-delay: 4s; }
      .sparkle-10 { top: 90%; right: 10%; animation-delay: 4.5s; }

      @keyframes float-sparkle {
        0%, 100% {
          transform: translateY(0) rotate(0deg) scale(1);
          opacity: 0.7;
        }
        25% {
          transform: translateY(-20px) rotate(90deg) scale(1.2);
          opacity: 1;
        }
        50% {
          transform: translateY(-10px) rotate(180deg) scale(0.9);
          opacity: 0.8;
        }
        75% {
          transform: translateY(-30px) rotate(270deg) scale(1.1);
          opacity: 1;
        }
      }
    </style>
  </body>
</html>
