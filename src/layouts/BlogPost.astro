---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="prose prose-lg prose-bauhaus max-w-none">
    <!-- Article header -->
    <header class="mb-12 relative">
      <!-- Date -->
      <p class="mb-4 text-bauhaus-cream/50 text-sm uppercase tracking-widest font-medium">
        <span class="text-green-800">&gt;</span> <FormattedDate date={pubDate} />
        {updatedDate && (
          <span class="ml-4 text-bauhaus-yellow/60">
            Updated: <FormattedDate date={updatedDate} />
          </span>
        )}
      </p>

      <!-- Title -->
      <h1 class="text-4xl md:text-6xl font-bold mb-2 text-bauhaus-cream leading-tight tracking-tight">
        {title}
      </h1>

      {description && (
        <p class="text-lg text-bauhaus-cream/50 italic mb-6">{description}</p>
      )}

      <!-- Thin red dividing line -->
      <div class="h-px w-full bg-bauhaus-red/30"></div>
    </header>

    <!-- Article content -->
    <div class="prose prose-lg prose-bauhaus max-w-none">
      <slot />
    </div>

    <!-- Comments section -->
    <div class="mt-16 pt-8 border-t border-sky-400/50">
      <h2 class="text-2xl font-bold text-bauhaus-cream mb-6 flex items-center gap-3 border-none">
        <span>🗣️</span>
        Comments
      </h2>
      <div id="veritula-comments"></div>
      <script is:inline>
        (function() {
          var container = document.getElementById('veritula-comments');
          var script = document.createElement('script');
          script.type = 'text/javascript';
          script.src = 'https://veritula.com/embed.js';
          script.setAttribute('data-public-user-id', 'a7d2ce0e-7da9-4aad-a385-dbb49077a3e2');
          var url = window.location.hostname === 'localhost'
            ? 'https://www.dirkswebsite.nl' + window.location.pathname
            : window.location.href;
          script.setAttribute('data-url', url);
          container.appendChild(script);
        })();
      </script>
    </div>
  </article>
</Layout>

<style is:global>
  /* Bauhaus prose styling */
  .prose-bauhaus {
    @apply text-bauhaus-cream/90;
  }

  .prose-bauhaus h1,
  .prose-bauhaus h2,
  .prose-bauhaus h3,
  .prose-bauhaus h4,
  .prose-bauhaus h5,
  .prose-bauhaus h6 {
    @apply text-bauhaus-cream font-bold tracking-tight;
  }

  .prose-bauhaus h2 {
    @apply text-3xl mt-12 mb-4 pb-2 border-b border-bauhaus-steel;
  }

  .prose-bauhaus h3 {
    @apply text-2xl mt-8 mb-3;
  }

  .prose-bauhaus a {
    @apply text-bauhaus-yellow no-underline border-b border-bauhaus-yellow/30 hover:border-bauhaus-yellow transition-colors;
  }

  .prose-bauhaus strong {
    @apply font-bold text-bauhaus-cream;
  }

  .prose-bauhaus em {
    @apply text-bauhaus-cream/80;
  }

  .prose-bauhaus code {
    @apply bg-bauhaus-charcoal text-bauhaus-yellow px-2 py-0.5 rounded text-sm font-mono;
  }

  .prose-bauhaus pre {
    @apply bg-bauhaus-charcoal p-6 rounded-none overflow-x-auto;
  }

  .prose-bauhaus pre code {
    @apply bg-transparent p-0 text-bauhaus-cream;
  }

  .prose-bauhaus blockquote {
    @apply border-l-4 border-bauhaus-yellow bg-bauhaus-charcoal/50 pl-6 py-4 pr-4 italic text-bauhaus-cream/80 not-italic;
  }

  .prose-bauhaus blockquote p {
    @apply m-0;
  }

  .prose-bauhaus ul {
    @apply list-none pl-0;
  }

  .prose-bauhaus ul li {
    @apply relative pl-6 mb-2;
  }

  .prose-bauhaus ul li::before {
    content: '';
    @apply absolute left-0 top-3 w-2 h-2 bg-bauhaus-red;
  }

  .prose-bauhaus ol {
    @apply list-none pl-0;
    counter-reset: item;
  }

  .prose-bauhaus ol li {
    @apply relative pl-8 mb-2;
    counter-increment: item;
  }

  .prose-bauhaus ol li::before {
    content: counter(item);
    @apply absolute left-0 top-0 w-5 h-5 bg-bauhaus-red text-bauhaus-cream text-xs font-bold;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prose-bauhaus img {
    @apply border-2 border-bauhaus-steel;
  }

  .prose-bauhaus hr {
    @apply border-none h-1 bg-bauhaus-red my-12;
  }

  .prose-bauhaus table {
    @apply border-2 border-bauhaus-steel;
  }

  .prose-bauhaus th {
    @apply bg-bauhaus-charcoal text-bauhaus-cream font-bold border-b-2 border-bauhaus-yellow;
  }

  .prose-bauhaus td {
    @apply border-b border-bauhaus-steel;
  }

  /* Light mode overrides */
  .light .prose-bauhaus,
  .light .prose-bauhaus p,
  .light .prose-bauhaus li,
  .light .prose-bauhaus td,
  .light .prose-bauhaus th {
    color: #333 !important;
  }

  .light .prose-bauhaus h1,
  .light .prose-bauhaus h2,
  .light .prose-bauhaus h3,
  .light .prose-bauhaus h4,
  .light .prose-bauhaus h5,
  .light .prose-bauhaus h6 {
    color: #1a1a1a !important;
  }

  .light .prose-bauhaus h2 {
    border-color: #ddd !important;
  }

  .light .prose-bauhaus a {
    color: #0369a1 !important;
    border-color: rgb(3 105 161 / 0.35) !important;
  }

  .light .prose-bauhaus a:hover {
    color: #075985 !important;
    border-color: #075985 !important;
  }

  .light .prose-bauhaus strong {
    color: #1a1a1a !important;
  }

  .light .prose-bauhaus em {
    color: #333 !important;
  }

  .light .prose-bauhaus code {
    background: rgba(0,0,0,0.07) !important;
    color: #991b1b !important;
  }

  .light .prose-bauhaus pre {
    background: rgba(0,0,0,0.05) !important;
  }

  .light .prose-bauhaus pre code {
    color: #1a1a1a !important;
  }

  .light .prose-bauhaus blockquote {
    background: rgba(0,0,0,0.03) !important;
    color: #444 !important;
  }

  .light .prose-bauhaus ul li::before {
    background: #E53935 !important;
  }

  .light .prose-bauhaus ol li::before {
    background: #b91c1c !important;
    color: white !important;
  }

  .light .prose-bauhaus th {
    background: rgb(0 0 0 / 0.06) !important;
  }

  .light .text-bauhaus-cream {
    color: #1a1a1a !important;
  }

  .light .text-bauhaus-cream\/60 {
    color: #666 !important;
  }

  .light .text-bauhaus-yellow\/60 {
    color: #92400e !important;
  }

  .light article header h1 {
    color: #1a1a1a !important;
  }

  .light article header > div:first-of-type {
    color: #666 !important;
  }

  .light .border-bauhaus-steel {
    border-color: #ddd !important;
  }

  /* Gay mode - FABULOUS prose */
  .gay .w-4.h-4.bg-bauhaus-red {
    background: linear-gradient(45deg, #FF69B4, #FFD700) !important;
    border-radius: 50%;
    animation: gay-sparkle 1s ease-in-out infinite;
  }

  .gay .h-1.w-32 {
    background: linear-gradient(90deg, red, orange, yellow, green, blue, purple) !important;
  }

  .gay .prose-bauhaus {
    @apply text-white/90;
  }

  .gay .prose-bauhaus h1,
  .gay .prose-bauhaus h2,
  .gay .prose-bauhaus h3 {
    @apply text-white;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3), 0 0 15px #FFD700;
  }

  .gay .prose-bauhaus h2 {
    border-color: #FF69B4;
  }

  .gay .prose-bauhaus a {
    color: #FFD700;
    border-color: #FFD700;
    text-shadow: 0 0 10px #FFD700;
  }

  .gay .prose-bauhaus a:hover {
    color: #FF69B4;
    border-color: #FF69B4;
  }

  .gay .prose-bauhaus strong {
    color: #FFD700;
  }

  .gay .prose-bauhaus code {
    background: rgba(255,105,180,0.3);
    color: #FFD700;
  }

  .gay .prose-bauhaus pre {
    background: rgba(155,89,182,0.3);
    border-left-color: #FF69B4;
  }

  .gay .prose-bauhaus pre code {
    color: white;
  }

  .gay .prose-bauhaus blockquote {
    background: rgba(255,215,0,0.2);
    border-left-color: #FFD700;
    color: white;
  }

  .gay .prose-bauhaus ul li::before {
    background: linear-gradient(45deg, #FF69B4, #FFD700) !important;
    border-radius: 50%;
  }

  .gay .prose-bauhaus ol li::before {
    background: linear-gradient(45deg, #FF69B4, #FFD700) !important;
  }

  .gay .prose-bauhaus hr {
    background: linear-gradient(90deg, red, orange, yellow, green, blue, purple) !important;
  }

  .gay .prose-bauhaus img {
    border-color: #FF69B4;
    box-shadow: 0 0 20px rgba(255,105,180,0.5);
  }

  .gay .border-t-2 {
    border-color: #FF69B4 !important;
  }

  .gay .w-2.h-2.bg-bauhaus-red {
    background: #FFD700 !important;
    border-radius: 50%;
    box-shadow: 0 0 10px #FFD700;
  }

  @keyframes gay-sparkle {
    0%, 100% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #FF69B4; }
    50% { transform: scale(1.2) rotate(180deg); box-shadow: 0 0 20px #FFD700; }
  }

</style>
